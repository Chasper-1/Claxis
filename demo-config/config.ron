// ---
// my-editor — Configuration demo file
// ---

Modes {
    editor {
    // mouse settings
        mouse_mode: bool,
        middle_click_paste: bool,
        step_scroll_lines: "u8",
        
    // space edit settings
        end_padding: u8,
        shell_os: "String", // Unix: "sh -c" / Windows: "cmd /C"
        line_number: Enum, // Enum > absolute else relative. line_number: absolute
        continue_comments: bool, // If you create a new line while in the comment line, the new line will continue the comment.
        auto_completion: bool,
        path_completion: "String",
    }
}

Themes {
    path: "~/Desktop/config/editor/theme",
}